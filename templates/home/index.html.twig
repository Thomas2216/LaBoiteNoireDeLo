{% extends 'base.html.twig' %}

{% block title %}La Boite Noire de Lo - Photographe de spectacle vivant{% endblock %}

{% block body %}
    {% if photos is empty %}
        <div class="empty-state container">Les photos arrivent bientot.</div>
    {% else %}
        {{ component('PhotoTitreBloc', { photo: photos[0], align: 'left', size: 32 }) }}

        {% for photo in photos|slice(1) %}
            {{ component('PhotoTitreBloc', {
                photo: photo,
                align: cycle(['right', 'left'], loop.index0),
                size: cycle([17, 26], loop.index0),
            }) }}
        {% endfor %}
    {% endif %}

    <div class="about">
        <div class="about-inner container">
            <div class="avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div>
                <h2>A MON SUJET</h2>
                <p>Laura Joly, ancienne travailleuse sociale fraichement reconvertie dans la diffusion de spectacle vivant, je m'interesse particulierement a l'art de rue. Selon moi, les spectacles et evenements engages permettent d'ouvrir les regards, de federer et de toucher le coeur du public. A travers ma boite noire, j'aime saisir les emotions a la volee.</p>
            </div>
        </div>
    </div>

    <div class="section-title container"><span>MES PRESTATIONS</span></div>
    <div class="rule"></div>
    <div class="prestations container">
        <div class="prestation">
            <p><span class="label">PHOTOGRAPHIE DE SPECTACLE</span><br>Captation, repetitions, portraits d'artistes, diffusion</p>
        </div>
        <div class="prestation">
            <p><span class="label">PHOTOGRAPHIE D'EVENEMENT</span><br>Festivals engages, rencontres, ateliers, cercles de parole</p>
        </div>
        <div class="prestation">
            <p><span class="label">PHOTOGRAPHIE ASSOCIATIVE</span><br>Artistique, luttes sociales, tiers-lieux</p>
        </div>
    </div>
{% endblock %}
