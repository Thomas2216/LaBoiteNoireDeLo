{% extends 'base.html.twig' %}

{% block title %}La Boite Noire de Lo - Photographe de spectacle vivant{% endblock %}

{% block body %}
    {% if photos is empty %}
        <div class="empty-state container">Les photos arrivent bientot.</div>
    {% else %}
        {{ component('PhotoTitreBloc', { photo: photos[0], align: 'left', size: 32 }) }}

        {% for photo in photos|slice(1) %}
            {{ component('PhotoTitreBloc', {
                photo: photo,
                align: cycle(['right', 'left'], loop.index0),
                size: cycle([17, 26], loop.index0),
            }) }}
        {% endfor %}
    {% endif %}

    <div class="about">
        <div class="about-inner container reveal" data-controller="reveal">
            <div class="avatar">
                {% if portrait and portrait.imageName %}
                    <img src="{{ ('uploads/photos/' ~ portrait.imageName)|imagine_filter('photo_thumb') }}" alt="Portrait de Laura Joly">
                {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                {% endif %}
            </div>
            <div>
                <h2>A MON SUJET</h2>
                <p>Laura Joly. Ancienne travailleuse sociale fraichement reconvertie dans la diffusion de spectacle vivant, je m'interesse particulierement a l'art de rue. Selon moi, les spectacles et evenements engages permettent d'ouvrir les regards, de federer, d'eduquer, de rassembler et de toucher le coeur du public. A travers ma boite noire, j'aime saisir les emotions a la volee, impregner mes photos de la saveur du moment et raconter des histoires a propos d'etres humains qui pensent d'autres manieres. Il me tient a coeur de travailler sur des projets aux valeurs d'entraide, de bienveillance et de partage dans le but de defendre, cette fois-ci par la culture, les causes sociales auxquelles je crois.</p>
            </div>
        </div>
    </div>

    <div class="section-title container"><span>MES PRESTATIONS</span></div>
    <div class="rule"></div>
    <div class="prestations container">
        <div class="prestation reveal" data-controller="reveal" data-reveal-delay-value="0">
            <span class="label">PHOTOGRAPHIE DE SPECTACLE</span>
            <ul>
                <li>Captation de representation</li>
                <li>Repetitions / residences</li>
                <li>Portraits d'artistes</li>
                <li>Images pour diffusion et communication</li>
            </ul>
        </div>
        <div class="prestation reveal" data-controller="reveal" data-reveal-delay-value="80">
            <span class="label">PHOTOGRAPHIE D'EVENEMENT</span>
            <ul>
                <li>Festivals d'art / engages</li>
                <li>Rencontres</li>
                <li>Ateliers</li>
                <li>Cercles de parole</li>
            </ul>
        </div>
        <div class="prestation reveal" data-controller="reveal" data-reveal-delay-value="160">
            <span class="label">PHOTOGRAPHIE ASSOCIATIVE</span>
            <ul>
                <li>Artistique</li>
                <li>Aux luttes sociales diverses</li>
                <li>Tiers-lieux</li>
            </ul>
        </div>
    </div>
{% endblock %}
