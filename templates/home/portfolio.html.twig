{% extends 'base.html.twig' %}

{% block title %}Portfolio - La Boite Noire de Lo{% endblock %}

{% block body %}
    {% set descriptions = {
        'photographie-spectacle': "Captation, repetitions, portraits d'artistes, diffusion",
        'photographie-evenement': 'Festivals engages, rencontres, ateliers, cercles de parole',
        'photographie-associative': 'Artistique, luttes sociales, tiers-lieux',
    } %}

    <div class="section-title container" style="padding-top:50px;"><span style="font-size:28px;">PORTFOLIO</span></div>
    <div class="rule"></div>

    {% if sections is empty %}
        <div class="empty-state container">Aucune categorie pour le moment.</div>
    {% endif %}

    <div data-controller="lightbox">
        {% for section in sections %}
            <div class="category-block container reveal" data-controller="reveal">
                <h3>{{ section.categorie.nom }}</h3>
                {% if descriptions[section.categorie.slug] is defined %}
                    <span class="sub">{{ descriptions[section.categorie.slug] }}</span>
                {% endif %}
            </div>

            {% if section.photos is empty %}
                <div class="empty-state container">Photos a venir dans cette categorie.</div>
            {% else %}
                <div class="gallery-grid container reveal" data-controller="reveal">
                    {% for photo in section.photos %}
                        {% if photo.imageName %}
                            <a href="{{ ('uploads/photos/' ~ photo.imageName)|imagine_filter('photo_large') }}"
                               class="cell glightbox"
                               data-gallery="cat-{{ section.categorie.slug }}"
                               data-title="{{ photo.titre }}"
                               data-description="{{ photo.legende }}">
                                <img src="{{ ('uploads/photos/' ~ photo.imageName)|imagine_filter('photo_thumb') }}" alt="{{ photo.titre }}" loading="lazy">
                            </a>
                        {% else %}
                            <div class="cell">
                                <svg class="placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}
