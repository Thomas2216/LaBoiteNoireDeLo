<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}La Boite Noire de Lo{% endblock %}</title>
        <link rel="icon" href="/favicon.ico" sizes="any">
        <link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512">
        <link rel="apple-touch-icon" href="/favicon-512.png">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% include 'partials/_header.html.twig' %}

        {% if app.flashes|length %}
            <div class="flash-wrap container">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash{{ label == 'error' ? ' error' : '' }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        {% block body %}{% endblock %}

        {% include 'partials/_footer.html.twig' %}
    </body>
</html>
