<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}La Boite Noire de Lo{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="wrap">
            {% include 'partials/_header.html.twig' %}

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash{{ label == 'error' ? ' error' : '' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}

            {% include 'partials/_footer.html.twig' %}
        </div>
    </body>
</html>
