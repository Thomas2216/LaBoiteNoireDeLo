{% extends 'base.html.twig' %}

{% block title %}Contact - La Boite Noire de Lo{% endblock %}

{% block body %}
    <div class="section-title container" style="padding-top:50px;"><span style="font-size:28px;">CONTACTEZ-MOI</span></div>
    <div class="rule"></div>

    <p style="text-align:center;font-size:12px;color:var(--text-muted);max-width:420px;margin:0 auto 10px;padding:0 28px;line-height:1.9;">
        Un projet, une envie de collaboration ? Ecrivez-moi, je reviens vers vous rapidement avec un devis adapte.
    </p>

    {{ form_start(form, { attr: { class: 'contact-form' } }) }}
        {{ form_row(form.nom, { attr: { placeholder: 'Votre nom' } }) }}
        {{ form_row(form.email, { attr: { placeholder: 'vous@exemple.fr' } }) }}
        {{ form_row(form.prestation) }}
        {{ form_row(form.message, { attr: { placeholder: 'Decrivez votre projet...' } }) }}
        <button type="submit">Envoyer le message</button>
    {{ form_end(form) }}
{% endblock %}
